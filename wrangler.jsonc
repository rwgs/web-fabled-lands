// Cloudflare Workers deployment (task 370): an assets-only Worker, no script.
// It publishes the repository root, so the root index.html's redirect into web/ and the
// /web/ URLs installed copies are registered at keep working; .assetsignore limits the
// upload to those two. The `deploy` job in .github/workflows/smoke.yml deploys it from main
// once CI passes, and the custom-domain route below creates the hostname's DNS record.
{
  "name": "web-fabled-lands",
  "compatibility_date": "2026-09-29",
  "assets": {
    "directory": "."
  },
  "routes": [
    { "pattern": "webfl.rwgs.net", "custom_domain": true }
  ]
}
